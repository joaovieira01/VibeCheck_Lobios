# Docker MySQL credentials (change both before starting)
MYSQL_ROOT_PASSWORD=CHANGE_ROOT_PASSWORD

# Frontend local development
VITE_API_URL=http://localhost:8000

# Backend database: mysql or sqlite
VIBECHECK_DB_ENGINE=mysql
VIBECHECK_DB_HOST=127.0.0.1
VIBECHECK_DB_PORT=3306
VIBECHECK_DB_NAME=vibecheck
VIBECHECK_DB_USER=vibecheck_user
VIBECHECK_DB_PASSWORD=CHANGE_THIS_PASSWORD
VIBECHECK_DB_PATH=data/vibecheck.db

VIBECHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIBECHECK_FRONTEND_URL=http://localhost:5173
VIBECHECK_SEED_DEMO_USER=false
VIBECHECK_RATE_LIMIT=true
