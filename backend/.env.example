# Para MySQL: crie o banco e usuário seguindo database/schema.sql.
VIBECHECK_DB_ENGINE=mysql
VIBECHECK_DB_HOST=127.0.0.1
VIBECHECK_DB_PORT=3306
VIBECHECK_DB_NAME=vibecheck
VIBECHECK_DB_USER=vibecheck_user
VIBECHECK_DB_PASSWORD=CHANGE_THIS_PASSWORD

VIBECHECK_DB_PATH=data/vibecheck.db
VIBECHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIBECHECK_FRONTEND_URL=http://localhost:5173
VIBECHECK_SMTP_HOST=
VIBECHECK_SMTP_PORT=587
VIBECHECK_SMTP_USER=
VIBECHECK_SMTP_PASSWORD=
VIBECHECK_SMTP_FROM=VibeCheck <no-reply@seudominio.com>
VIBECHECK_SMTP_STARTTLS=true
VIBECHECK_SESSION_TTL_HOURS=168
VIBECHECK_RESET_TTL_MINUTES=30
VIBECHECK_SEED_DEMO_USER=false
VIBECHECK_MAX_SOURCE_BYTES=1000000
VIBECHECK_MAX_HISTORY=20
VIBECHECK_MAX_LINE_CHARS=1000
VIBECHECK_SCAN_TIMEOUT_SECONDS=10
VIBECHECK_RATE_LIMIT=true
